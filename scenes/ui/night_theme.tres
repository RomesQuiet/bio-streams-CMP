[gd_resource type="Theme" format=3]

; The buttons at night (user, 7 Nov 2026): black with white text and border. Put on the main
; screen by scripts/ui/main.gd while the sky is dark; everything else comes from main_theme.tres.

[sub_resource type="StyleBoxFlat" id="Night_normal"]
content_margin_left = 14.0
content_margin_top = 8.0
content_margin_right = 14.0
content_margin_bottom = 8.0
bg_color = Color(0, 0, 0, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 1, 1, 1)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18


[resource]
default_font_size = 26
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")
Button/styles/normal = SubResource("Day_normal")
Button/styles/hover = SubResource("Day_hover")
Button/styles/pressed = SubResource("Day_pressed")
Button/styles/disabled = SubResource("Day_disabled")
Button/styles/focus = SubResource("Day_focus")
Button/styles/hover_pressed = SubResource("Day_pressed")
Button/colors/font_color = Color(0, 0, 0, 1)
Button/colors/font_hover_color = Color(0, 0, 0, 1)
Button/colors/font_pressed_color = Color(0, 0, 0, 1)
Button/colors/font_focus_color = Color(0, 0, 0, 1)
Button/colors/font_hover_pressed_color = Color(0, 0, 0, 1)
Button/colors/icon_normal_color = Color(0, 0, 0, 1)
Button/colors/icon_hover_color = Color(0, 0, 0, 1)
Button/colors/icon_pressed_color = Color(0, 0, 0, 1)
Button/colors/icon_focus_color = Color(0, 0, 0, 1)
Button/colors/icon_hover_pressed_color = Color(0, 0, 0, 1)
Button/colors/font_disabled_color = Color(0.5, 0.5, 0.5, 1)
Button/colors/icon_disabled_color = Color(0.5, 0.5, 0.5, 1)
Button/colors/font_outline_color = Color(0, 0, 0, 0)
ProgressBar/styles/background = SubResource("Day_bar_empty")
ProgressBar/styles/fill = SubResource("Day_bar_fill")
ProgressBar/colors/font_color = Color(1, 1, 1, 1)
XPBar/base_type = &"ProgressBar"
XPBar/styles/fill = SubResource("Day_bar_xp_fill")
HealthBar/base_type = &"ProgressBar"
HealthBar/styles/fill = SubResource("Day_bar_health_fill")
HealthBarDanger/base_type = &"ProgressBar"
HealthBarDanger/styles/fill = SubResource("Day_bar_danger_fill")
